/**
 * 'yyyy-MM-dd' / Date → "26 ตุลาคม 2569" (Buddhist era, the format a Thai HR inbox expects).
 *
 * Built from an explicit month table rather than a locale-dependent `MMMM`: Utilities
 * .formatDate has no locale argument here, and a stray English month in an otherwise Thai
 * sentence is exactly the kind of unprofessional detail this copy is meant to avoid.
 */
function thaiDateLabel_(value, tz) {
  var tzSafe = tz || 'Asia/Bangkok';
  // Duck-typed rather than `instanceof Date`, so a Date built by another script context (a
  // test harness, a library) is still formatted instead of printed with a JS stack trace.
  var iso = (value && typeof value.getTime === 'function')
    ? Utilities.formatDate(new Date(value.getTime()), tzSafe, 'yyyy-MM-dd')
    : String(value == null ? '' : value).trim();
  var m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(iso);
  if (!m) return iso;                                  // unparseable: show it, never guess

  var MONTHS = ['มกราคม', 'กุมภาพันธ์', 'มีนาคม', 'เมษายน', 'พฤษภาคม', 'มิถุนายน',
                'กรกฎาคม', 'สิงหาคม', 'กันยายน', 'ตุลาคม', 'พฤศจิกายน', 'ธันวาคม'];
  var month = parseInt(m[2], 10);
  return parseInt(m[3], 10) + ' ' + (MONTHS[month - 1] || m[2]) + ' ' + (parseInt(m[1], 10) + 543);
}

/** Replace {placeholders} — throws on a missing key so a typo cannot ship. */
function fill_(template, vars) {
  return String(template).replace(/\{(\w+)\}/g, function (_, key) {
    if (!(key in vars)) throw new Error('Missing message variable: ' + key);
    return vars[key];
  });
}
